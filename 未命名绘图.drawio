          <mxGeometry height="178" width="730" x="40" y="1002" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="b0" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#2563A6;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l0_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFF5E7;strokeColor=#C07920;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=22;align=center;verticalAlign=middle;spacing=18;fontStyle=1;" value="任务3&lt;br&gt;质量评估与可信治理" vertex="1">
          <mxGeometry height="110" width="300" x="850" y="2070" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="core" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#C07920;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1_0" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C07920;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="输入条件与数据&lt;br&gt;原始数据、量程/标定、缺失日志、工况和专家核验样本&lt;br&gt;需保留原始值；建立分工况参考数据与真实异常依据&lt;br&gt;修复验证需已知真值或可控遮蔽样本，避免仅凭平滑判断效果" vertex="1">
          <mxGeometry height="178" width="730" x="40" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="b1" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#C07920;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l1_0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1_1" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C07920;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="治理步骤&lt;br&gt;规则 → 完整/有效检查 → 异常/漂移检测 → 跨源核验&lt;br&gt;→ 有条件修复/缺失掩码 → 质量标签与血缘版本" vertex="1">
          <mxGeometry height="178" width="730" x="40" y="1738" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="b1" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#C07920;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l1_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1_2" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C07920;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="规则、Hampel/MAD与变化点&lt;br&gt;规则：解释清楚、成本低；依赖阈值和业务覆盖&lt;br&gt;Hampel/MAD：稳健筛查尖峰；窗口不当可能误报真实瞬变&lt;br&gt;变化点：定位统计状态变化；正常工况切换也会触发" vertex="1">
          <mxGeometry height="178" width="730" x="40" y="1936" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="b1" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#C07920;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l1_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1_3" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C07920;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" tooltip="技术参考 https://scikit-learn.org/stable/modules/generated/sklearn.ensemble.IsolationForest.html；场景优劣势为本项目选型分析，需实测验证。" value="Isolation Forest与时序自编码器&lt;br&gt;IF：无需故障标签，适合多维异常筛查；依赖特征/阈值&lt;br&gt;自编码器：学习非线性时序；需代表性参考数据与训练算力&lt;br&gt;共同局限：异常分数不能直接区分设备故障与数据错误" vertex="1">
          <mxGeometry height="178" width="730" x="40" y="2134" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="b1" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#C07920;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l1_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1_4" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C07920;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="输出与治理边界&lt;br&gt;规则库、质量标签、可信样本、前后评测与数据血缘&lt;br&gt;保留原始/修复值、置信度和掩码；真实故障不能当脏数据删除" vertex="1">
          <mxGeometry height="178" width="730" x="40" y="2332" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="b1" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#C07920;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l1_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#EDF8F3;strokeColor=#25836D;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=22;align=center;verticalAlign=middle;spacing=18;fontStyle=1;" value="任务2&lt;br&gt;时空对齐与跨模态融合" vertex="1">
          <mxGeometry height="110" width="300" x="1730" y="740" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="core" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#25836D;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_0" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#25836D;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="输入条件与数据&lt;br&gt;图像/红外、振动/声纹、电气量、微气象及设备标识/时间戳&lt;br&gt;需时钟偏差说明、采样率、单位与可比较的工况窗口&lt;br&gt;深度融合需可靠配对样本、验证集与足够算力；保留缺失模态标记" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="210" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="b2" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#25836D;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l2_0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_1" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#25836D;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="关联与融合步骤&lt;br&gt;时间校核 → 对象匹配 → 多频率窗口 → 一致性检查&lt;br&gt;→ 状态表征/可靠性评估 → 动态融合 → 关联样本导出" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="408" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="b2" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#25836D;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l2_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_2" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#25836D;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" tooltip="技术参考 https://tslearn.readthedocs.io/en/stable/user_guide/dtw.html；场景优劣势为本项目选型分析，需实测验证。" value="时间窗口、互相关与DTW&lt;br&gt;窗口：简单、保留原频率；时间偏差会造成错配&lt;br&gt;互相关：估计相似时序的滞后；弱相关/非平稳时不可靠&lt;br&gt;DTW：容纳局部速度变化；长序列成本高，需约束过度扭曲" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="606" as="geometry" />
        </mxCell>
        <mxCell id="e15" edge="1" parent="1" source="b2" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#25836D;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l2_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_3" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#25836D;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="特征级、决策级与质量门控&lt;br&gt;特征级：利用互补信息；需尺度/语义对齐，噪声可能相互传递&lt;br&gt;决策级：模块独立、易组合；需评分校准，细粒度交互较弱&lt;br&gt;门控：按质量/工况调权；依赖可靠质量信号及校准验证" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="804" as="geometry" />
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="b2" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#25836D;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l2_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_4" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#25836D;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="输出与适用边界&lt;br&gt;关联样本、融合特征、关联置信度及服务接口&lt;br&gt;不强制同频；定位依据不足时不强配无人机影像&lt;br&gt;关联置信度与设备故障置信度分开表达" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="1002" as="geometry" />
        </mxCell>
        <mxCell id="e17" edge="1" parent="1" source="b2" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#25836D;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l2_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F3EFF9;strokeColor=#7554A3;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=22;align=center;verticalAlign=middle;spacing=18;fontStyle=1;" value="任务4&lt;br&gt;边缘处理与标准服务" vertex="1">
          <mxGeometry height="110" width="300" x="1730" y="2070" as="geometry" />
        </mxCell>
        <mxCell id="e18" edge="1" parent="1" source="core" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#7554A3;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l3_0" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7554A3;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="输入条件与现场环境&lt;br&gt;网关/开发板、厂家协议、授权数据与下游接口需求&lt;br&gt;需可用供电/时钟/持久化存储、网络权限及资源余量&lt;br&gt;明确数据速率、允许时延、断网时长与缓存容量，先核定可保障范围" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="e19" edge="1" parent="1" source="b3" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#7554A3;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l3_0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l3_1" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7554A3;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="边缘处理与服务步骤&lt;br&gt;采集适配 → 预处理/质控 → 分级缓存 → 补传/去重校验&lt;br&gt;→ 统一封装 → 接口联调与断网恢复测试" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="1738" as="geometry" />
        </mxCell>
        <mxCell id="e20" edge="1" parent="1" source="b3" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#7554A3;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l3_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l3_2" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7554A3;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="事件优先级与本地队列/缓存&lt;br&gt;优势：重点事件优先留存，缓冲短时网络波动&lt;br&gt;前提：事件规则、持久化队列、磁盘与供电条件可用&lt;br&gt;局限：规则漏检会丢失重要性判断；持续断网可能耗尽缓存" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="1936" as="geometry" />
        </mxCell>
        <mxCell id="e21" edge="1" parent="1" source="b3" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#7554A3;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l3_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l3_3" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7554A3;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="序列号、校验和与幂等去重&lt;br&gt;优势：分别辅助查漏乱序、内容损坏检查和重复入库控制&lt;br&gt;前提：唯一标识、确认/重试机制、状态记录与存储配合&lt;br&gt;局限：这些机制不能代替补传；校验和也不等同于安全认证" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="2134" as="geometry" />
        </mxCell>
        <mxCell id="e22" edge="1" parent="1" source="b3" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#7554A3;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l3_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l3_4" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7554A3;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="标准服务输出与边界&lt;br&gt;对象/测点/时间/单位/工况/质量/来源/版本数据契约&lt;br&gt;服务原型、恢复测试、接口与血缘查询；不发送启停/复位指令&lt;br&gt;生产接入需审批；采集侧机制与子任务4的平台同步复用" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="2332" as="geometry" />
        </mxCell>
        <mxCell id="e23" edge="1" parent="1" source="b3" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#7554A3;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l3_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="阅读方式  中心 → 彩色主题 → 技术细节    ｜    同色连线表示归属关系，不表示严格执行顺序" vertex="1">
          <mxGeometry height="42" width="2800" x="40" y="2790" as="geometry" />
        </mxCell>
        <mxCell id="l0_5" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563A6;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="设备关联图与实施选择&lt;br&gt;前提：设备—部件—测点关系可维护&lt;br&gt;优势：多级关系查询清晰，便于扩展与追溯&lt;br&gt;局限：关系采集和持续维护有成本；简单场景先用映射表" vertex="1">
          <mxGeometry height="178" width="730" x="40" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="extra0" edge="1" parent="1" source="b0" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#2563A6;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l0_5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l1_5" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C07920;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="跨源核验与有条件修复&lt;br&gt;跨源：相互印证；依赖可比关系，多源共同失效时受限&lt;br&gt;插值：简单且易部署；仅适合有依据的短缺口，不能还原故障瞬变&lt;br&gt;时序重建：可利用上下文；依赖数据分布，可能生成错误细节" vertex="1">
          <mxGeometry height="178" width="730" x="40" y="2530" as="geometry" />
        </mxCell>
        <mxCell id="extra1" edge="1" parent="1" source="b1" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#C07920;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l1_5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l2_5" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#25836D;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" tooltip="技术参考 https://arxiv.org/abs/2101.03961；场景优劣势为本项目选型分析，需实测验证。" value="深度融合备选方法 优势与局限&lt;br&gt;注意力：学习跨模态交互；依赖配对数据，算力/过拟合需控制&lt;br&gt;对比学习：可利用无故障标签配对数据；错配正样本影响表征&lt;br&gt;稀疏专家：按工况选择专家；需数据覆盖与路由均衡，部署更复杂" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="extra2" edge="1" parent="1" source="b2" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#25836D;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l2_5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l3_5" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7554A3;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" tooltip="技术参考 https://docs.oasis-open.org/mqtt/mqtt/v5.0/mqtt-v5.0.html；场景优劣势为本项目选型分析，需实测验证。" value="MQTT与边缘轻量检测&lt;br&gt;MQTT：发布订阅便于解耦；需代理与会话配置，QoS有开销/重复权衡&lt;br&gt;轻量检测：降低边缘时延与计算需求；表达能力受资源限制&lt;br&gt;前提：协议获准、现场实测；MQTT不替代应用层缓存/唯一标识" vertex="1">
          <mxGeometry height="178" width="730" x="2110" y="2530" as="geometry" />
        </mxCell>
        <mxCell id="extra3" edge="1" parent="1" source="b3" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#7554A3;strokeWidth=2.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l3_5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

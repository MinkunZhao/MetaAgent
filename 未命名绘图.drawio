        <mxCell id="b0" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#EEF5FD;strokeColor=#2563A6;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=22;align=center;verticalAlign=middle;spacing=18;fontStyle=1;" value="任务1&lt;br&gt;感知需求与对象关联" vertex="1">
          <mxGeometry height="110" width="300" x="850" y="740" as="geometry" />
        </mxCell>
        <mxCell id="e0" edge="1" parent="1" source="core" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#2563A6;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="b0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l0_0" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563A6;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="输入条件与数据&lt;br&gt;台账/点表/编码/部件层级；布设/巡检/地形资料&lt;br&gt;需数据访问权限、可核实的设备标识和现场联系人&lt;br&gt;空间关联还需统一坐标系、设备坐标及拍摄位置/视角" vertex="1">
          <mxGeometry height="178" width="730" x="40" y="210" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="b0" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#2563A6;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l0_0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l0_1" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563A6;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="实施步骤&lt;br&gt;场景与设备选择 → 数据源盘点 → 主数据映射&lt;br&gt;→ 感知覆盖/盲区分析 → 接入规范与字典确认" vertex="1">
          <mxGeometry height="178" width="730" x="40" y="408" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="b0" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#2563A6;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l0_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l0_2" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563A6;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="规则匹配与模糊去重&lt;br&gt;前提：设备编号、名称、型号或位置等字段可用&lt;br&gt;优势：规则可解释，少样本即可实施，维护路径清晰&lt;br&gt;局限：错码、别名及同名设备易误配；歧义需人工确认" vertex="1">
          <mxGeometry height="178" width="730" x="40" y="606" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="b0" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#2563A6;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l0_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l0_3" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563A6;strokeWidth=1.6;fontColor=#20344B;fontFamily=Noto Sans CJK SC;fontSize=20;align=left;verticalAlign=middle;spacing=18;fontStyle=0;" value="GIS空间关联与巡检映射&lt;br&gt;前提：坐标、地形与巡检定位信息可用且基准一致&lt;br&gt;优势：直观分析覆盖与盲区，辅助影像归属&lt;br&gt;局限：定位/视角误差与遮挡影响匹配，近邻不等于同一设备" vertex="1">
          <mxGeometry height="178" width="730" x="40" y="804" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="b0" style="edgeStyle=entityRelationEdgeStyle;curved=1;segment=28;startArrow=none;endArrow=none;html=1;strokeColor=#2563A6;strokeWidth=2.2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="l0_3">
          <mxGeometry relative="1" as="geometry" />
